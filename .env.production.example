# Copy to .env.production on the server and fill in. Never commit the filled-in file.
TAG=latest
WEB_PORT=3000
# The address people open in their browser (used for sign-in redirects).
AUTH_URL=http://your-hpc-host:3000
# Generate both with: openssl rand -hex 32
AUTH_SECRET=
POSTGRES_PASSWORD=
# At least one sign-in method is needed in production (dev login is always off):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EMAIL_SERVER=
EMAIL_FROM=
