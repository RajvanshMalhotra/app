DATABASE_URL=postgres://app:app@localhost:5432/app
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test
MATH_URL=http://localhost:8001
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me
# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: email sign-in links. Leave the example value to disable.
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=noreply@example.com
# Development only: shows a "Dev login" that signs in as any email. Never set this on a server.
ENABLE_DEV_LOGIN=1
